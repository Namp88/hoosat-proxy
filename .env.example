# Server Configuration
PORT=3000

# Hoosat Node Configuration
HOOSAT_HOST=127.0.0.1
HOOSAT_PORT=42420
HOOSAT_TIMEOUT=10000

# Multiple nodes with automatic failover (overrides HOOSAT_HOST/HOOSAT_PORT).
# Comma-separated host:port list, port defaults to 42420, the first node is primary.
# Production list:
# HOOSAT_NODES=htn.foztor.net:42420,htn-lon.foztor.net:42420,51.89.232.58:42420,188.220.202.0:42420,194.163.168.43:42420,91.66.117.194:42420
HOOSAT_NODES=

# API Configuration
API_PREFIX=api
API_VERSION=v1